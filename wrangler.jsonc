{
  // Cloudflare Workers config: serve everything in ./public as a static site.
  "name": "tankap-com",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  // Only serve on tankap.com / www.tankap.com, not *.workers.dev.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "tankap.com", "custom_domain": true },
    { "pattern": "www.tankap.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Run src/worker.js first so it can redirect www before serving files.
    "run_worker_first": true
  }
}
